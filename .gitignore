# to obtain/place it before packaging.
resources/jre-win-x64

# Regenerated by "Build Card Tag Index" in-app — 150MB+, over GitHub's 100MB per-file push limit.
# resources/tagger-data and resources/combo-index stay tracked (small, and tagger-data took a
# multi-hour scrape to build) — only this one is excluded.
resources/card-tag-index
