{
  "name": "biblioplex",
  "version": "1.0.3",
  "description": "BiblioPLEX — MTG deck building, card info, and recommendations desktop app",
  "main": "./out/main/index.js",
  "author": "Martyris",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.biblioplex.app",
    "productName": "BiblioPLEX",
    "files": ["out/**/*"],
    "extraResources": [
      {
        "from": "java-bridge/target/java-bridge-1.0-jar-with-dependencies.jar",
        "to": "java-bridge/java-bridge-1.0-jar-with-dependencies.jar"
      },
      {
        "from": "resources/tagger-data",
        "to": "tagger-data"
      },
      {
        "from": "resources/card-tag-index",
        "to": "card-tag-index"
      },
      {
        "from": "resources/combo-index",
        "to": "combo-index"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "portable",
      "extraResources": [
        {
          "from": "resources/jre-win-x64",
          "to": "jre-win-x64"
        }
      ]
    },
    "mac": {
      "icon": "resources/icon.png"
    },
    "linux": {
      "icon": "resources/icon.png"
    }
  }
}
